@model LittleTigerV2.Models.ResultadoGiro

<div style="text-align: center; background: #1a1a1a; color: gold; padding: 50px; border-radius: 20px;">
    <h1>🐅 TIGRINHO DA SORTE 🎰</h1>

    <div style="font-size: 80px; padding: 20px; border: 5px solid gold; display: inline-block; border-radius: 10px; background: #000;">
        @Model.Slot1 | @Model.Slot2 | @Model.Slot3
    </div>

    <h2 style="color: @(Model.Venceu ? "lime" : "orange")">@Model.Mensagem</h2>

    <form asp-controller="Tigrinho" asp-action="Girar" method="post">
        <button type="submit" class="btn-spin">
            GIRAR AGORA! 🎲
        </button>
    </form>
</div>